# Public client configuration only. Never put a Supabase service-role key or
# RevenueCat secret API key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Use the platform-specific RevenueCat public SDK keys for sway_premium.
# Configure a Current Offering with Annual and/or Monthly packages in RevenueCat.
# When keys are absent, store checkout is disabled; free features still work.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional existing single-platform fallback:
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Set real published HTTPS documents before App Store / Google Play release.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Backend prerequisite: enable Anonymous Sign-ins in Supabase Auth, then apply
# supabase/migrations/202610010001_partner_access.sql in the SQL Editor.
# Existing device-ID prototype pairs must relink; Her local cycle is preserved.
# Rebuild the development client after adding Lottie / Expo Crypto:
# npx eas-cli@latest build --profile development --platform android
# (Use --platform ios for iOS.) Do not run EAS from here without authorization.
